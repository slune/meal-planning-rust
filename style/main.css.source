@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --color-primary: theme('colors.sky.700');
    --color-primary-hover: theme('colors.sky.800');
    --color-danger: theme('colors.rose.600');
    --color-danger-hover: theme('colors.rose.700');
    --color-success: theme('colors.emerald.600');
    --color-warning: theme('colors.amber.600');
    --color-info: theme('colors.sky.600');
    --color-text-primary: theme('colors.slate.900');
    --color-text-secondary: theme('colors.slate.600');
    --color-border: theme('colors.slate.200');
  }

  body {
    @apply bg-slate-50 text-slate-900 antialiased;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    margin: 0;
    min-height: 100vh;
    font-size: 15px;
    line-height: 1.5;
  }

  .sr-only {
    @apply absolute w-px h-px p-0 -m-px overflow-hidden whitespace-nowrap border-0;
    clip: rect(0, 0, 0, 0);
  }

  h1, .heading-1 {
    @apply text-3xl font-semibold text-slate-950 tracking-normal;
  }

  h2, .heading-2 {
    @apply text-2xl font-semibold text-slate-950 tracking-normal;
  }

  h3, .heading-3 {
    @apply text-xl font-semibold text-slate-900 tracking-normal;
  }

  h4, .heading-4 {
    @apply text-base font-semibold text-slate-900 tracking-normal;
  }

  p {
    @apply text-slate-600;
  }

  table {
    border-collapse: collapse;
  }
}

@layer components {
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .page-header {
    @apply flex flex-wrap items-end justify-between gap-4 border-b border-slate-200 pb-5;
  }

  .page-heading {
    @apply flex min-w-0 items-start gap-4;
  }

  .page-kicker {
    @apply text-xs font-semibold uppercase tracking-wide text-slate-500;
  }

  .page-title {
    @apply mt-1 text-3xl font-semibold text-slate-950;
  }

  .page-subtitle {
    @apply mt-2 max-w-3xl text-sm text-slate-600;
  }

  .section-title {
    @apply text-lg font-semibold text-slate-900;
  }

  .inline-icon {
    @apply inline-flex h-4 w-4 shrink-0 items-center justify-center;
  }

  .inline-icon svg,
  .btn svg {
    @apply h-4 w-4;
  }

  .toolbar {
    @apply flex flex-wrap items-center gap-3;
  }

  .app-mark {
    @apply inline-flex h-9 w-9 items-center justify-center rounded-lg border border-sky-200 bg-sky-50 text-sky-800;
  }

  .app-mark svg,
  .nav-icon svg,
  .icon-badge svg {
    @apply h-5 w-5;
  }

  .nav-icon {
    @apply inline-flex h-4 w-4 shrink-0 items-center justify-center;
  }

  .nav-icon svg {
    @apply h-4 w-4;
  }

  .workspace-hero {
    @apply rounded-lg border border-slate-200 bg-white p-6 shadow-sm;
    border-top: 4px solid theme('colors.sky.600');
    background:
      linear-gradient(90deg, rgba(14, 165, 233, 0.11), rgba(16, 185, 129, 0.07) 42%, rgba(255, 255, 255, 0.95) 78%),
      #ffffff;
  }

  .workspace-side-panel {
    @apply rounded-lg border border-slate-200 bg-white/90 p-4 shadow-sm;
  }

  .home-action {
    @apply relative overflow-hidden rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition-colors duration-150;
  }

  .home-action:hover {
    @apply border-slate-300 bg-slate-50 no-underline;
  }

  .home-action::before {
    content: "";
    @apply absolute inset-x-0 top-0 h-1 bg-slate-300;
  }

  .home-action-sky::before {
    @apply bg-sky-500;
  }

  .home-action-emerald::before {
    @apply bg-emerald-500;
  }

  .home-action-amber::before {
    @apply bg-amber-500;
  }

  .home-action-rose::before {
    @apply bg-rose-500;
  }

  .home-action-violet::before {
    @apply bg-violet-500;
  }

  .panel-accent {
    @apply border-t-4;
  }

  .panel-accent-sky {
    @apply border-t-sky-500;
  }

  .panel-accent-emerald {
    @apply border-t-emerald-500;
  }

  .panel-accent-amber {
    @apply border-t-amber-500;
  }

  .panel-accent-rose {
    @apply border-t-rose-500;
  }

  .panel-accent-violet {
    @apply border-t-violet-500;
  }

  .icon-badge {
    @apply inline-flex h-10 w-10 items-center justify-center rounded-lg border;
  }

  .icon-badge-sky {
    @apply border-sky-200 bg-sky-50 text-sky-700;
  }

  .icon-badge-emerald {
    @apply border-emerald-200 bg-emerald-50 text-emerald-700;
  }

  .icon-badge-amber {
    @apply border-amber-200 bg-amber-50 text-amber-700;
  }

  .icon-badge-rose {
    @apply border-rose-200 bg-rose-50 text-rose-700;
  }

  .icon-badge-violet {
    @apply border-violet-200 bg-violet-50 text-violet-700;
  }

  .status-chip {
    @apply inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold;
  }

  .status-chip-sky {
    @apply border-sky-200 bg-sky-50 text-sky-800;
  }

  .status-chip-emerald {
    @apply border-emerald-200 bg-emerald-50 text-emerald-800;
  }

  .status-chip-amber {
    @apply border-amber-200 bg-amber-50 text-amber-800;
  }

  .status-chip-rose {
    @apply border-rose-200 bg-rose-50 text-rose-800;
  }

  .status-chip-violet {
    @apply border-violet-200 bg-violet-50 text-violet-800;
  }

  .btn {
    @apply inline-flex items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-semibold transition-colors duration-150;
    @apply disabled:cursor-not-allowed disabled:opacity-50;
    cursor: pointer;
    letter-spacing: 0;
  }

  .btn-primary {
    @apply border-sky-700 bg-sky-700 text-white hover:border-sky-800 hover:bg-sky-800;
  }

  .btn-secondary {
    @apply border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-50;
  }

  .btn-danger {
    @apply border-rose-600 bg-rose-600 text-white hover:border-rose-700 hover:bg-rose-700;
  }

  .btn-sm {
    @apply px-3 py-1.5 text-xs;
  }

  .btn-lg {
    @apply px-5 py-2.5 text-base;
  }

  .btn-icon {
    @apply h-9 w-9 p-0;
  }

  .card {
    @apply rounded-lg border border-slate-200 bg-white p-6 shadow-sm;
  }

  .record-card {
    @apply flex h-full flex-col rounded-lg border border-slate-200 bg-white p-5 shadow-sm;
  }

  .record-card-sky {
    @apply border-t-4 border-t-sky-500;
  }

  .record-card-emerald {
    @apply border-t-4 border-t-emerald-500;
  }

  .record-card-amber {
    @apply border-t-4 border-t-amber-500;
  }

  .record-card-rose {
    @apply border-t-4 border-t-rose-500;
  }

  .record-card-violet {
    @apply border-t-4 border-t-violet-500;
  }

  a.card {
    @apply block cursor-pointer no-underline transition-colors duration-150;
  }

  a.card:hover {
    @apply border-slate-300 bg-slate-50;
  }

  .empty-state {
    @apply rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center;
  }

  .form-input {
    @apply w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm transition-colors duration-150;
    @apply hover:border-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-100;
  }

  .form-input:disabled {
    @apply cursor-not-allowed bg-slate-100 text-slate-500;
  }

  .form-label {
    @apply mb-1.5 block text-sm font-semibold text-slate-700;
    letter-spacing: 0;
  }

  textarea.form-input {
    @apply resize-y;
  }

  nav a {
    @apply no-underline;
  }

  .tab-active {
    @apply inline-flex items-center border-b-2 border-sky-700 px-1 py-3 text-sm font-semibold text-sky-800;
  }

  .tab-inactive {
    @apply inline-flex items-center border-b-2 border-transparent px-1 py-3 text-sm font-semibold text-slate-500 hover:text-slate-800;
  }

  .alert-error {
    @apply rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800;
  }

  .alert-success {
    @apply rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800;
  }

  .alert-info {
    @apply rounded-md border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800;
  }

  .spinner {
    @apply inline-block h-6 w-6 animate-spin rounded-full border-2 border-sky-700 border-t-transparent;
  }

  .badge {
    @apply inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold;
    letter-spacing: 0;
  }

  .badge-primary {
    @apply border-sky-200 bg-sky-50 text-sky-800;
  }

  .badge-secondary {
    @apply border-slate-200 bg-slate-100 text-slate-700;
  }

  .badge-success {
    @apply border-emerald-200 bg-emerald-50 text-emerald-800;
  }

  .dropdown-menu {
    @apply absolute z-10 mt-1 max-h-60 w-full overflow-auto rounded-md border border-slate-300 bg-white shadow-lg;
  }

  .dropdown-item {
    @apply cursor-pointer px-3 py-2 text-sm text-slate-700 transition-colors duration-100;
  }

  .dropdown-item:hover {
    @apply bg-slate-50;
  }

  .dropdown-item-selected {
    @apply bg-sky-50 font-semibold text-sky-800;
  }

  .card-grid {
    @apply grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3;
  }

  a:not(.card):not(.btn) {
    @apply cursor-pointer text-sky-700 hover:text-sky-900 hover:underline;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    @apply bg-slate-100;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    @apply rounded-full bg-slate-300 hover:bg-slate-400;
  }

  .modal-backdrop {
    @apply fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4;
    animation: fadeIn 0.15s ease-out;
  }

  .modal-content {
    @apply w-full max-w-md rounded-lg border border-slate-200 bg-white shadow-xl;
    animation: slideIn 0.18s ease-out;
  }

  .modal-header {
    @apply border-b border-slate-200 px-5 py-4;
  }

  .modal-title {
    @apply m-0 text-lg font-semibold text-slate-950;
  }

  .modal-body {
    @apply px-5 py-4 text-sm text-slate-700;
  }

  .modal-footer {
    @apply flex justify-end gap-2 border-t border-slate-200 px-5 py-4;
  }

  .toast-container {
    @apply fixed right-4 top-4 z-50 flex max-w-sm flex-col gap-2;
  }

  .toast {
    @apply flex items-start gap-3 rounded-md border bg-white px-4 py-3 shadow-lg;
    animation: slideInRight 0.18s ease-out;
  }

  .toast-icon {
    @apply flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold;
  }

  .toast-message {
    @apply flex-1 text-sm font-medium;
  }

  .toast-close {
    @apply h-5 w-5 shrink-0 cursor-pointer border-0 bg-transparent p-0 text-lg leading-none text-slate-400 hover:text-slate-700;
  }

  .toast-success {
    @apply border-emerald-200 bg-emerald-50;
  }

  .toast-success .toast-icon {
    @apply bg-emerald-600 text-white;
  }

  .toast-success .toast-message {
    @apply text-emerald-900;
  }

  .toast-error {
    @apply border-rose-200 bg-rose-50;
  }

  .toast-error .toast-icon {
    @apply bg-rose-600 text-white;
  }

  .toast-error .toast-message {
    @apply text-rose-900;
  }

  .toast-info {
    @apply border-sky-200 bg-sky-50;
  }

  .toast-info .toast-icon {
    @apply bg-sky-600 text-white;
  }

  .toast-info .toast-message {
    @apply text-sky-900;
  }

  .toast-warning {
    @apply border-amber-200 bg-amber-50;
  }

  .toast-warning .toast-icon {
    @apply bg-amber-600 text-white;
  }

  .toast-warning .toast-message {
    @apply text-amber-900;
  }

  .spinner-sm {
    @apply h-4 w-4 border-2;
  }

  .spinner-lg {
    @apply h-10 w-10 border-4;
  }

  .loading-overlay {
    @apply fixed inset-0 z-40 flex items-center justify-center bg-slate-950/30;
  }

  .loading-overlay-content {
    @apply flex flex-col items-center gap-3 rounded-lg bg-white p-6 shadow-xl;
  }

  .loading-overlay-message {
    @apply text-sm font-medium text-slate-700;
  }

  .skeleton-loader {
    @apply space-y-3;
  }

  .skeleton-row {
    @apply animate-pulse rounded bg-slate-200;
  }

  .skeleton-card {
    @apply animate-pulse;
  }

  .form-field {
    @apply space-y-2;
  }

  .form-help-text {
    @apply text-sm text-slate-500;
  }

  .form-error {
    @apply text-sm font-medium text-rose-600;
  }

  .form-checkbox {
    @apply h-4 w-4 rounded border-slate-300 text-sky-700 focus:ring-2 focus:ring-sky-500;
  }

  .data-table {
    @apply w-full text-sm;
  }

  .data-table thead {
    @apply border-y border-slate-200 bg-slate-50;
  }

  .data-table th {
    @apply px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500;
  }

  .data-table td {
    @apply border-b border-slate-100 px-3 py-2 text-slate-700;
  }

  .report-preview {
    @apply overflow-x-auto;
  }

  .report-preview h2 {
    @apply mb-1 text-xl font-semibold text-slate-950;
  }

  .report-preview h3 {
    @apply mb-3 border-b border-slate-200 pb-2 text-base font-semibold text-slate-900;
  }

  .report-preview h4 {
    @apply mb-2 text-sm font-semibold text-slate-700;
  }

  .report-preview table {
    @apply w-full text-sm;
  }

  .report-preview thead {
    @apply border-y border-slate-200 bg-slate-50;
  }

  .report-preview th {
    @apply px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500;
  }

  .report-preview td {
    @apply border-b border-slate-100 px-3 py-2 text-slate-700;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
}

@layer utilities {
  .text-gradient,
  .text-gradient-green {
    @apply text-slate-950;
    font-weight: 600;
  }
}
